@model IEnumerable<DSW1_T1_BlasReynaHarold.Models.Libro>
@{
    ViewData["Title"] = "Listado de libros";
}

<h1 class="mb-4">Listado de libros</h1>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-@(ViewBag.TipoMensaje ?? "info") alert-dismissible fade show" role="alert">
        @ViewBag.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="mb-3">
    <a asp-action="Crear" class="btn btn-primary">Registrar libro</a>
    <a asp-action="BuscarPorAutor" class="btn btn-outline-secondary">Buscar por autor</a>
</div>

<table class="table table-striped table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th>
            <th>@Html.DisplayNameFor(model => model.NombreLibro)</th>
            <th>@Html.DisplayNameFor(model => model.Autor)</th>
            <th>@Html.DisplayNameFor(model => model.NombreEditorial)</th>
            <th>@Html.DisplayNameFor(model => model.ISDN)</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center">No hay libros registrados.</td>
            </tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.NombreLibro</td>
                <td>@item.Autor</td>
                <td>@item.NombreEditorial</td>
                <td>@item.ISDN</td>
                <td class="text-center text-nowrap">
                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>

                    <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Está seguro de eliminar este libro?');">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
